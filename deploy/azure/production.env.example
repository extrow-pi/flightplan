# Settings for deploy/azure/setup.sh. Copy to deploy/azure/production.env (ignored by git) and fill in.

# ── Azure resources ────────────────────────────────────────────────────────────
AZURE_SUBSCRIPTION=            # name or ID; blank = the az CLI's current subscription
RESOURCE_GROUP=flightplan
LOCATION=canadacentral
CONTAINERAPP_ENV=flightplan-env
CONTAINERAPP_NAME=flightplan
# Globally unique, 3–24 lowercase letters and digits. Holds the floor map uploads share.
STORAGE_ACCOUNT=

# ── Container image (built by .github/workflows/deploy.yml) ────────────────────
IMAGE=ghcr.io/extrow-pi/flightplan:latest
# Only needed while the GHCR package is private: a GitHub username and a classic personal
# access token with just the read:packages scope.
GHCR_USERNAME=
GHCR_TOKEN=

# ── App settings (the same names as apps/api/.env) ─────────────────────────────
# Supabase → Connect → "Session pooler" string, with ?sslmode=require on the end
DATABASE_URL=
# New random value for production: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Public URL of the site. Blank = the Container App's own https://…azurecontainerapps.io address.
BETTER_AUTH_URL=
RESEND_API_KEY=
EMAIL_FROM=Flightplan <onboarding@resend.dev>
APP_TIMEZONE=America/Vancouver
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
