# Settings for the dev site: bash deploy/azure/setup.sh dev.env
# Copy to deploy/azure/dev.env (ignored by git) and fill in. It shares the live site's resource
# group, Container Apps environment and storage account, with its own app, uploads share and database.

# ── Azure resources ────────────────────────────────────────────────────────────
AZURE_SUBSCRIPTION=            # name or ID; blank = the az CLI's current subscription
RESOURCE_GROUP=flightplan
LOCATION=canadacentral
CONTAINERAPP_ENV=flightplan-env
CONTAINERAPP_NAME=flightplan-dev
# The live site's storage account (STORAGE_ACCOUNT in production.env)
STORAGE_ACCOUNT=
UPLOADS_SHARE=uploads-dev
# Sleep while nobody's using it, so it costs next to nothing. The first visit after a quiet
# spell takes a few seconds. Emails and payment reminders only run while it's awake.
MIN_REPLICAS=0
# Shown in the corner of every page; also asks search engines not to index the site
SITE_LABEL=Dev site

# ── Container image (built by .github/workflows/deploy.yml) ────────────────────
# Only used when first creating the app; the "Deploy to dev site" workflow sets it after that
IMAGE=ghcr.io/extrow-pi/flightplan:latest
# Only needed while the GHCR package is private: a GitHub username and a classic personal
# access token with just the read:packages scope.
GHCR_USERNAME=
GHCR_TOKEN=

# ── App settings (the same names as apps/api/.env) ─────────────────────────────
# A separate Supabase project for test data, never the live database.
# Supabase → Connect → "Session pooler" string, with ?sslmode=require on the end
DATABASE_URL=
# New random value, different from the live site's: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Public URL of the site. Blank = the Container App's own https://…azurecontainerapps.io address.
# Set it once the custom domain is added (see README), then re-run the setup.
BETTER_AUTH_URL=
# Leave blank: emails are logged in the Email log instead of sent, so tests never reach real vendors
RESEND_API_KEY=
EMAIL_FROM=Flightplan <onboarding@resend.dev>
APP_TIMEZONE=America/Vancouver
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
