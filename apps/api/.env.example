# Leave unset to use the embedded PGlite database in apps/api/.data
# DATABASE_URL=postgres://user:password@host:5432/flightplan
API_PORT=3001
# Where uploaded images (floor maps) are stored. Default: apps/api/.data/uploads
# UPLOADS_DIR=

# Auth (Better Auth). Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# Public URL of the web app (dev: the Vite server, which proxies /api to this API)
BETTER_AUTH_URL=http://localhost:5173

# Google sign-in. Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails (vendor notifications). Without RESEND_API_KEY nothing is sent; emails show up in the
# dashboard's Email log instead. Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend. onboarding@resend.dev only
# delivers to your own Resend account's email, which is handy for testing.
EMAIL_FROM=Flightplan <onboarding@resend.dev>
# Timezone for payment deadlines shown in emails
APP_TIMEZONE=America/Vancouver
